{
  // Update these values for your own account before deploying from a fork.
  "name": "skylight-mcp-remote",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BRIDGE_REQUEST_TIMEOUT_MS": "30000",
    "LOG_LEVEL": "info",
    "PORT": "8080"
  },
  "containers": [
    {
      "class_name": "SkylightBridgeContainer",
      // Replace this with the image digest from your own Cloudflare registry push.
      "image": "registry.cloudflare.com/6413bfbe023fbf879350a20fe7a2245b/skylight-mcp-remote@sha256:30d5f9f99f8d45376c13a60dca2a4f1c5f2b462513e83e57852d191c70df7e92",
      "max_instances": 2,
      "name": "skylight-mcp-bridge"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SkylightBridgeContainer",
        "name": "SKYLIGHT_BRIDGE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkylightBridgeContainer"]
    }
  ]
}
