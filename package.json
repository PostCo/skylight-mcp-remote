{
  "name": "mastra-skylight-mcp",
  "private": true,
  "description": "Cloudflare-hosted remote MCP bridge for the skylight-mcp Ruby server, sized for concurrent Mastra investigation sessions",
  "license": "MIT",
  "version": "0.1.0",
  "homepage": "https://github.com/PostCo/skylight-mcp-remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostCo/skylight-mcp-remote.git"
  },
  "bugs": {
    "url": "https://github.com/PostCo/skylight-mcp-remote/issues"
  },
  "workspaces": [
    "apps/bridge",
    "apps/worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:bridge": "npm run build --workspace @skylight-mcp-remote/bridge",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces",
    "dev:bridge": "tsx apps/bridge/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.103.0"
  }
}
